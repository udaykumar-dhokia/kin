{
  "info": {
    "name": "Kin - Life Admin OS API",
    "description": "Comprehensive API collection for Kin (Life Admin OS) with pre-configured requests, chained authentication tokens, and automated test assertions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3333",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "createdBillId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "description": "User registration, Argon2id authentication, session lifecycle, and token management",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "description": "Registers a new user with Argon2id password hashing, creates an active session, and returns tokens.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"StrongPassword123!\",\n  \"firstName\": \"Alex\",\n  \"lastName\": \"Kumar\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "name": "201 User registered successfully",
              "status": "201",
              "code": 201,
              "body": "{\n  \"message\": \"User registered successfully\",\n  \"user\": {\n    \"id\": \"3fa85f64-5717-4562-b3fc-2c963f66afa6\",\n    \"email\": \"user@example.com\",\n    \"firstName\": \"Alex\",\n    \"lastName\": \"Kumar\",\n    \"avatarUrl\": null,\n    \"emailVerified\": false\n  },\n  \"accessToken\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n  \"refreshToken\": \"c79f8263e8a4a...\"\n}",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ]
            },
            {
              "name": "400 Validation failed",
              "status": "400",
              "code": 400,
              "body": "",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ]
            },
            {
              "name": "409 User with this email already exists",
              "status": "409",
              "code": 409,
              "body": "",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ]
            }
          ],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {\n    pm.response.to.have.status(201);\n});\nconst response = pm.response.json();\nif (response.accessToken) {\n    pm.collectionVariables.set(\"accessToken\", response.accessToken);\n    console.log(\"Collection variable 'accessToken' updated.\");\n}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Authenticates credentials using Argon2id, generates a new session, and returns tokens.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"StrongPassword123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "name": "200 Login successful",
              "status": "200",
              "code": 200,
              "body": "{\n  \"message\": \"Login successful\",\n  \"user\": {\n    \"id\": \"3fa85f64-5717-4562-b3fc-2c963f66afa6\",\n    \"email\": \"user@example.com\",\n    \"firstName\": \"Alex\",\n    \"lastName\": \"Kumar\"\n  },\n  \"accessToken\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n  \"refreshToken\": \"c79f8263e8a4a...\"\n}",
              "header": [
