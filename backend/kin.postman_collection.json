          "response": [
            {
              "name": "200 User profile details",
              "status": "200",
              "code": 200,
              "body": "{\n  \"user\": {\n    \"id\": \"3fa85f64-5717-4562-b3fc-2c963f66afa6\",\n    \"email\": \"user@example.com\",\n    \"firstName\": \"Alex\",\n    \"lastName\": \"Kumar\",\n    \"avatarUrl\": null,\n    \"emailVerified\": false\n  }\n}",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ]
            },
            {
              "name": "401 Unauthorized",
              "status": "401",
              "code": 401,
              "body": "",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ]
            }
          ],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {\n    pm.response.to.have.status(200);\n});\nconst response = pm.response.json();\npm.test(\"User object returned\", function () {\n    pm.expect(response.user).to.be.an(\"object\");\n    pm.expect(response.user.email).to.be.a(\"string\");\n});"
                ]
              }
            }
          ]
        },
