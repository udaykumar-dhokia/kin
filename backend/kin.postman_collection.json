    {
      "name": "Bills & Payments",
      "description": "Life Admin OS financial responsibilities, attention dashboard, recurrence scheduling, and attachments",
      "item": [
        {
          "name": "Get Attention Dashboard",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/bills/dashboard",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "bills",
                "dashboard"
              ]
            },
            "description": "Returns categorized urgent items (Overdue, Due Soon in 7 days, Upcoming in 30 days) and financial totals."
          },
          "response": [
            {
              "name": "200 Dashboard attention view",
              "status": "200",
              "code": 200,
              "body": "{\n  \"dashboard\": {\n    \"overdue\": [],\n    \"dueSoon\": [],\n    \"upcoming\": [],\n    \"metrics\": {\n      \"totalPendingAmount\": 22000,\n      \"overdueCount\": 0,\n      \"dueSoonCount\": 0,\n      \"upcomingCount\": 1,\n      \"currency\": \"INR\"\n    }\n  }\n}",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ]
            }
          ],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {\n    pm.response.to.have.status(200);\n});\nconst response = pm.response.json();\npm.test(\"Dashboard contains attention categories\", function () {\n    pm.expect(response.dashboard).to.be.an(\"object\");\n    pm.expect(response.dashboard.overdue).to.be.an(\"array\");\n    pm.expect(response.dashboard.dueSoon).to.be.an(\"array\");\n    pm.expect(response.dashboard.upcoming).to.be.an(\"array\");\n    pm.expect(response.dashboard.metrics).to.be.an(\"object\");\n});"
                ]
              }
            }
          ]
        },
