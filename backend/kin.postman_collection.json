              "raw": "{\n  \"title\": \"Apartment Rent\",\n  \"description\": \"Monthly apartment rent payment to landlord\",\n  \"category\": \"RENT\",\n  \"amount\": 22000,\n  \"currency\": \"INR\",\n  \"dueDate\": \"2026-11-01T00:00:00.000Z\",\n  \"isRecurring\": true,\n  \"recurrenceInterval\": \"MONTHLY\",\n  \"notes\": \"Landlord bank transfer\"\n}",
