            {
              "name": "401 Invalid email or password",
              "status": "401",
              "code": 401,
              "body": "",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ]
            }
          ],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {\n    pm.response.to.have.status(200);\n});\nconst response = pm.response.json();\nif (response.accessToken) {\n    pm.collectionVariables.set(\"accessToken\", response.accessToken);\n    console.log(\"Collection variable 'accessToken' updated.\");\n}"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "refresh"
              ]
            },
            "description": "Rotates refresh token and issues a new access token. Reads from cookie or JSON body.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"optional_refresh_token_if_not_in_cookie\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "name": "200 Token refreshed successfully",
              "status": "200",
              "code": 200,
              "body": "{\n  \"message\": \"Token refreshed successfully\",\n  \"accessToken\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n  \"refreshToken\": \"new_rotated_refresh_token...\"\n}",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ]
            },
            {
              "name": "401 Invalid or expired session",
              "status": "401",
              "code": 401,
              "body": "",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ]
            }
          ],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {\n    pm.response.to.have.status(200);\n});\nconst response = pm.response.json();\nif (response.accessToken) {\n    pm.collectionVariables.set(\"accessToken\", response.accessToken);\n}"
                ]
              }
            }
          ]
        },
