              "status": "200",
              "code": 200,
              "body": "{\n  \"message\": \"Login successful\",\n  \"user\": {\n    \"id\": \"3fa85f64-5717-4562-b3fc-2c963f66afa6\",\n    \"email\": \"user@example.com\",\n    \"firstName\": \"Alex\",\n    \"lastName\": \"Kumar\"\n  },\n  \"accessToken\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n  \"refreshToken\": \"c79f8263e8a4a...\"\n}",
              "header": [
