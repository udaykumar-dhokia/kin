        {
          "name": "List Bills",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/bills?status=PENDING&category=RENT&page=1&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "bills"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "PENDING",
                  "description": "Filter by status (PENDING, PAID, OVERDUE, CANCELLED)"
                },
                {
                  "key": "category",
                  "value": "RENT",
                  "description": "Filter by category (RENT, ELECTRICITY, etc.)"
                },
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number"
                },
                {
                  "key": "limit",
                  "value": "20",
                  "description": "Results per page (max 100)"
                }
              ]
            },
            "description": "Retrieves a paginated list of bills with optional filters for status, category, date range, or search."
          },
          "response": [
            {
              "name": "200 List of bills and pagination metadata",
              "status": "200",
              "code": 200,
              "body": "{\n  \"bills\": [],\n  \"pagination\": {\n    \"total\": 1,\n    \"page\": 1,\n    \"limit\": 20,\n    \"totalPages\": 1\n  }\n}",
              "header": [
