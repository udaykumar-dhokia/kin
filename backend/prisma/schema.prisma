// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BillCategory {
  ELECTRICITY
  WATER
  INTERNET_BROADBAND
  RENT
  CREDIT_CARD
  LOAN_EMI
  SUBSCRIPTION
  INSURANCE_PREMIUM
  EDUCATION_FEES
  GAS_UTILITY
  TAX
  OTHER
}

enum BillStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum RecurrenceInterval {
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

enum FamilyRelationship {
  SELF
  SPOUSE
  FATHER
  MOTHER
  SON
  DAUGHTER
  BROTHER
  SISTER
  OTHER
}

enum HouseholdRole {
  OWNER
  ADMIN
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

model User {
  id String @id @default(uuid())

  email        String  @unique
  passwordHash String

  firstName String
  lastName  String?

  avatarUrl     String?
  emailVerified Boolean @default(false)

  sessions Session[]
  bills    Bill[]

  // Household & Family relations
  ownedHouseholds      Household[]           @relation("HouseholdOwner")
  householdMemberships HouseholdMember[]
  sentInvitations      HouseholdInvitation[] @relation("SentInvitations")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id String @id @default(uuid())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash String @unique

  deviceId   String?
  deviceName String?

  expiresAt  DateTime
  lastUsedAt DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model Household {
  id       String @id @default(uuid())
  name     String
  currency String @default("INR")

  ownerId String
  owner   User   @relation("HouseholdOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  members     HouseholdMember[]
  invitations HouseholdInvitation[]
  bills       Bill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model HouseholdMember {
  id String @id @default(uuid())

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  name         String
  relationship FamilyRelationship @default(OTHER)
  role         HouseholdRole      @default(MEMBER)
  avatarUrl    String?
  dateOfBirth  DateTime?
  color        String?
  notes        String?

  assignedBills Bill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([householdId, userId])
  @@index([householdId])
  @@index([userId])
}

model HouseholdInvitation {
  id String @id @default(uuid())

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  invitedById String
  invitedBy   User   @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: Cascade)

  email        String
  name         String
  relationship FamilyRelationship @default(SPOUSE)
  role         HouseholdRole      @default(MEMBER)

  token     String           @unique
  status    InvitationStatus @default(PENDING)
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
  @@index([email])
  @@index([token])
}

model Bill {
  id String @id @default(uuid())

  // Ownership
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Household & Assigned Family Member
  householdId String?
  household   Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)

  assignedMemberId String?
  assignedMember   HouseholdMember? @relation(fields: [assignedMemberId], references: [id], onDelete: SetNull)

  // Core Bill Details
  title       String
  description String?
  category    BillCategory @default(OTHER)

  // Financial Information
  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("INR")

  // Timing & Lifecycle
  dueDate DateTime
  status  BillStatus @default(PENDING)

  // Payment Tracking
  paidAt        DateTime?
  paidAmount    Decimal?  @db.Decimal(10, 2)
  paymentMethod String?   // "UPI", "Credit Card", "Net Banking", "Auto-debit", etc.

  // Recurrence
  isRecurring        Boolean             @default(false)
  recurrenceInterval RecurrenceInterval?

  // Self-relation for recurring series
  parentBillId String?
  parentBill   Bill?   @relation("BillRecurrenceSeries", fields: [parentBillId], references: [id], onDelete: SetNull)
  childBills   Bill[]  @relation("BillRecurrenceSeries")

  // Attached Documents via Cloudinary
  billUrl    String? // Invoice / statement URL
  receiptUrl String? // Payment confirmation / screenshot URL

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([userId, category])
  @@index([parentBillId])
  @@index([householdId])
  @@index([assignedMemberId])
}